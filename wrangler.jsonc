{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upsidelifts",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "remote": true,
    },
  ],
  "vars": {
    "NUXT_PUBLIC_PREFIX": "upside",
    "NUXT_PUBLIC_URL": "https://upsidelifts.com",
    "NUXT_PUBLIC_GA_ID": "G-DPXHZZZ3PE",
    "NUXT_MAIL_FROM": "upside@fume.bio",
    "NUXT_MAIL_TO": "Jeff@UpsideLifts.com",
  },
  "previews": {
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "send_email": [
      {
        "name": "SEND_EMAIL",
        "remote": true,
      },
    ],
    "vars": {
      "NUXT_PUBLIC_PREFIX": "upside",
      "NUXT_PUBLIC_URL": "https://upsidelifts.acidjazz.workers.dev",
      "NUXT_MAIL_FROM": "upside@fume.bio",
      "NUXT_MAIL_TO": "Jeff@UpsideLifts.com",
    },
  },
}
